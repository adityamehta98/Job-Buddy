# Notification channel(s): telegram, whatsapp, ntfy, discord
NOTIFY_CHANNELS=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Keep US jobs plus remote roles that are not explicitly foreign-only.
US_ONLY=1
ALLOW_REMOTE=1

# Scraping and relevance
COMPANIES=all
INCLUDE_KEYWORDS=
MAX_PAGES_CAP=5
MAX_AGE_HOURS=24
MATCH_THRESHOLD=75
FETCH_JOB_DESCRIPTIONS=1
JD_FETCH_LIMIT=30

# Local/headless resume input. Prefer CV_TEXT as a GitHub Actions secret for
# scheduled runs; do not commit a personal resume to the repository.
CV_PATH=

# Optional alternatives
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=
GREENAPI_API_URL=https://api.green-api.com
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
GREENAPI_CHAT_ID=
